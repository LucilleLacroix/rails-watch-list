<h1><%= @list.name %></h1>

<h2>Movies in this list</h2>
<ul>
  <% @movies.each do |movie| %>
    <li>
      <strong><%= movie.title %></strong> - <%= movie.overview %>

      <% bookmark = @list.bookmarks.find_by(movie: movie) %>

      <% if bookmark %>
        <p>Comment: <%= bookmark.comment %></p>
        <%= button_to "Delete Bookmark", bookmark_path(bookmark),
                      method: :delete,
                      class: "btn btn-danger btn-sm" %>
      <% else %>
        <%= link_to "Add Bookmark", new_list_bookmark_path(@list, movie_id: movie.id), class: "btn btn-primary btn-sm" %>
      <% end %>
    </li>
  <% end %>
</ul>

<%= link_to "Back to Lists", lists_path, class: "btn btn-secondary mt-3" %>

