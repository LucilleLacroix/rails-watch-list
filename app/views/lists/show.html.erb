<h1><%= @list.name %></h1>

<%= link_to "Add a new movie", new_list_bookmark_path(@list) %>

<h2>Movies in this List</h2>
<ul>
  <% @list.movies.each do |movie| %>
  <li>
    <%= movie.title %>
    <%= movie.overview %>
    <% if movie.poster_url.present? %>
      <img class="card-img-top" src= "<%= movie.poster_url %>" alt="<%= movie.title %>">
    </li>
    <% end %>
  <% end %>
</ul>
