<h1>Create a new list</h1>

<%= form_with model: @list, local: true do |f| %>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="actions mt-2">
    <%= f.submit "Create List", class: "btn btn-primary" %>
    <%= link_to "Back", lists_path, class: "btn btn-secondary" %>
  </div>
<% end %>

