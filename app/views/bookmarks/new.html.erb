<h1>Add a Movie to <%= @list.name %></h1>

<%= simple_form_for [@list, @bookmark] do |f| %>
  <div class="mb-2">
    <%= f.input :movie_id,
                collection: Movie.all - @list.movies,
                label: "Select a Movie" %>
  </div>

  <%= f.button :submit, "Add Movie", class: "btn btn-primary" %>
<% end %>

<%= link_to "Back to List", list_path(@list), class: "btn btn-secondary mt-2" %>
